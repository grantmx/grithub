{
  "version": 1,
  "functions": {
    "/_middleware": {
      "runtime": "nodejs",
      "matchers": [
        {
          "regexp": "^(?:\\/(_next\\/data\\/[^/]{1,}))?(?:\\/((?!_next\\/|brand\\/|icon\\.svg|favicon\\.ico).*))(\\.json)?[\\/#\\?]?$",
          "originalSource": "/((?!_next/|brand/|icon\\.svg|favicon\\.ico).*)"
        }
      ]
    }
  }
}