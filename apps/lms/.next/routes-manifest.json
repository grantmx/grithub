{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ],
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
    }
  ],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/admin/people/[userId]/recovery",
      "regex": "^/admin/people/([^/]+?)/recovery(?:/)?$",
      "routeKeys": {
        "nxtPuserId": "nxtPuserId"
      },
      "namedRegex": "^/admin/people/(?<nxtPuserId>[^/]+?)/recovery(?:/)?$"
    },
    {
      "page": "/auth/link/[token]",
      "regex": "^/auth/link/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPtoken": "nxtPtoken"
      },
      "namedRegex": "^/auth/link/(?<nxtPtoken>[^/]+?)(?:/)?$"
    },
    {
      "page": "/setup/[token]",
      "regex": "^/setup/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPtoken": "nxtPtoken"
      },
      "namedRegex": "^/setup/(?<nxtPtoken>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/account/passkeys",
      "regex": "^/account/passkeys(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/account/passkeys(?:/)?$"
    },
    {
      "page": "/admin",
      "regex": "^/admin(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin(?:/)?$"
    },
    {
      "page": "/admin/cohorts",
      "regex": "^/admin/cohorts(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/cohorts(?:/)?$"
    },
    {
      "page": "/admin/people",
      "regex": "^/admin/people(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/people(?:/)?$"
    },
    {
      "page": "/admin/people/import",
      "regex": "^/admin/people/import(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/people/import(?:/)?$"
    },
    {
      "page": "/admin/people/invite",
      "regex": "^/admin/people/invite(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/people/invite(?:/)?$"
    },
    {
      "page": "/api/health",
      "regex": "^/api/health(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/api/health(?:/)?$"
    },
    {
      "page": "/forbidden",
      "regex": "^/forbidden(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/forbidden(?:/)?$"
    },
    {
      "page": "/icon.svg",
      "regex": "^/icon\\.svg(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/icon\\.svg(?:/)?$"
    },
    {
      "page": "/setup",
      "regex": "^/setup(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/setup(?:/)?$"
    },
    {
      "page": "/signin",
      "regex": "^/signin(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/signin(?:/)?$"
    },
    {
      "page": "/signin/check-email",
      "regex": "^/signin/check\\-email(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/signin/check\\-email(?:/)?$"
    },
    {
      "page": "/signin/help",
      "regex": "^/signin/help(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/signin/help(?:/)?$"
    },
    {
      "page": "/staff",
      "regex": "^/staff(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/staff(?:/)?$"
    },
    {
      "page": "/staff/evidence",
      "regex": "^/staff/evidence(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/staff/evidence(?:/)?$"
    },
    {
      "page": "/staff/marking",
      "regex": "^/staff/marking(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/staff/marking(?:/)?$"
    },
    {
      "page": "/staff/moderation",
      "regex": "^/staff/moderation(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/staff/moderation(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments",
    "clientParamParsing": false,
    "dynamicRSCPrerender": false
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}