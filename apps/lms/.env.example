# apps/lms environment variables — NAMES ONLY. Never put values in this file.
# Real values live in the Vercel project settings and in an untracked .env.local.
# Every variable here is also registered in apps/lms/turbo.json (tasks.build.env).

# App
NEXT_PUBLIC_APP_URL=

# Database (Postgres via Drizzle, packages/db)
DATABASE_URL=
DATABASE_SSL=
DATABASE_POOL_MAX=

# Sessions and passkeys (WebAuthn)
# SESSION_SECRET: at least 32 random characters (HMAC key for IP/email hashes in rate limits and audit).
# WEBAUTHN_RP_ID: the domain, e.g. the production hostname. CHANGING IT INVALIDATES EVERY PASSKEY.
# WEBAUTHN_ORIGIN: full origin, e.g. https://<host>. Must be on WEBAUTHN_RP_ID.
SESSION_SECRET=
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=
WEBAUTHN_ORIGIN=

# Practical evidence: Vercel Blob, PRIVATE store (design decision 2026-11-08).
# BLOB_READ_WRITE_TOKEN: from the Vercel Blob store (private access). Uploads go
# straight from the browser to the store; files are opened via 5-minute signed links.
# EVIDENCE_STORE: blob (default when the token is set) | memory (tests only).
BLOB_READ_WRITE_TOKEN=
EVIDENCE_STORE=

# Object storage (S3-compatible, signed direct uploads) - not used; evidence uses Vercel Blob above.
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Hosted audio/video (Mux, signed playback)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=

# Email: Resend in production. EMAIL_TRANSPORT = resend | console (dev: prints subject + link only) | memory (tests)
EMAIL_TRANSPORT=
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=

# Airtable one-way sync (outbox worker)
AIRTABLE_ACCESS_TOKEN=
AIRTABLE_BASE_ID=

# Vercel Cron authentication
CRON_SECRET=

# Encryption of sensitive personal information (QCTO learner profile; packages/db/src/pii.ts)
# PII_ENCRYPTION_KEYS: comma-separated <version>:<base64 32-byte key>, e.g. 1:<key>. The highest
#   version encrypts; keep older versions until every row is re-encrypted. Losing a key loses the data.
# PII_BLIND_INDEX_KEY: base64 32-byte HMAC key for ID-number lookups. Never rotate it casually:
#   changing it orphans every blind index.
PII_ENCRYPTION_KEYS=
PII_BLIND_INDEX_KEY=

# Nightly encrypted database backups (Form 5 4.1.6; design.md §14, 2026-11-09)
# BACKUP_ENCRYPTION_KEY: base64 32-byte key (AES-256-GCM). Keep a copy OUTSIDE the
#   database host (e.g. the password manager): without it the backups can't be restored.
BACKUP_ENCRYPTION_KEY=
# BACKUP_BLOB_READ_WRITE_TOKEN: read-write token of a SEPARATE private Vercel Blob store used only
#   for backups (never the evidence store; the job refuses the evidence store's token). Without it
#   the nightly run is logged as failed.
# BACKUP_STORE: memory (tests only). Leave empty in every deployed environment.
BACKUP_BLOB_READ_WRITE_TOKEN=
BACKUP_STORE=

# Restore tests only (scripts/restore-backup.ts; never set in Vercel): admin URL of an EMPTY,
# freshly migrated scratch database. The script refuses DATABASE_URL and production.
RESTORE_DATABASE_URL=
