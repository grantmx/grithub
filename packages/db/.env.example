# packages/db environment variables: NAMES ONLY. Never commit values.
# Copy to packages/db/.env (git-ignored) for local work.

# Main connection string. The database REGION is whichever host this URL points at;
# no host, region or credential is hard-coded anywhere in this package.
DATABASE_URL=

# "require" (default for non-local hosts) or "disable" (local Docker).
DATABASE_SSL=

# Max connections per process (default 5; keep this low on serverless).
DATABASE_POOL_MAX=

# Admin connection used ONLY by tests: they create and drop a throwaway
# database per test file. Point it at a local or disposable server, never production.
TEST_DATABASE_URL=

# Seeding safety: the demo seed refuses non-local hosts unless this is "true".
ALLOW_DEMO_SEED=

# Local Docker Postgres (docker-compose.yml reads these).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=
